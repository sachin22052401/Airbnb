<%- include('../layouts/boilerplate') -%>

<div class="container mt-5">
    <h2>Your Wishlist</h2>
    <% if (wishlist && wishlist.listings.length > 0) { %>
        <div class="row">
            <% wishlist.listings.forEach(function(listing) { %>
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
                        <div class="card-body">
                            <h5 class="card-title"><%= listing.title %></h5>
                            <p class="card-text"><%= listing.location %></p>
                            <a href="/listings/<%= listing._id %>" class="btn btn-primary">View Listing</a>
                            <form action="/wishlist/remove/<%= listing._id %>" method="POST" class="d-inline">
                                <button class="btn btn-danger">Remove</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <p>You have no listings in your wishlist.</p>
    <% } %>
</div>
